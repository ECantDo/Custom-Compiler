const FREE_MASK: u16 = 0x8000;
const ADDRESS_MASK: u16 = FREE_MASK - 1;
const HEAP_SIZE: u16 = 127; // 127 words --- change if I make the memory larger

fn initialize_heap() {
	// The heap will be 1 leading word + 128 words (for now)
	// This also means that the second word will be the first heap node.
	store(0, 1); // Funny enough, this still works for bump allocation
	// Each linked-list node will start with 1 word, and end with 1 word.
	// Each word leading and trailing will contain the size of the node (in words, not bytes), and a flag as the
	// top-bit. 1 = This chunk of memory IS free; 0 = This chunk of memory is NOT free.
	let free_size = FREE_MASK | HEAP_SIZE;

	// Our entire heap is free, so store 0x807F -> `heap_size` with top bit on
	// store(1, free_size);

	// We do not need to store at the end of our heap, because nothing comes after it
}

