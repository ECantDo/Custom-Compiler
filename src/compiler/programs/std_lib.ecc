fn malloc(size: u16) -> *mut u16 {
	let current_ptr = fetch(0) as u16;
	let next_ptr = current_ptr + size;

	// Fast boundary check against your hardcoded Heap limit
	if next_ptr > HEAP_SIZE {
		return 1 as *mut u16;
	}

	store(0, next_ptr); // "Bump" the pointer forward for the next allocation
	return current_ptr as *mut u16; // Return the raw, zero-overhead address
}

fn free() {
	store(0, 1);
}